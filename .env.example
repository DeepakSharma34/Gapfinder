# Demo is fully local: deterministic questions + lexical hash embeddings.
# Live requires GROQ_API_KEY and pip install -e '.[semantic]'.
APP_MODE=demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Leave empty to choose hash in demo and fastembed in live.
EMBEDDING_BACKEND=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATABASE_URL=sqlite:///./data/gapfinder.db
# For Postgres: postgresql+psycopg://gapfinder:gapfinder@localhost:5432/gapfinder
# Leave QDRANT_URL empty for embedded, persistent local Qdrant.
QDRANT_URL=
QDRANT_API_KEY=
DATA_DIR=./data
COOKIE_SECURE=false
DEMO_EMAIL=demo@gapfinder.local
DEMO_PASSWORD=study-better-2026
